    block.innerHTML=`<div class="semaine-header ${isExamWeek?'exam-header':''}">
      <div class="semaine-num">${isExamWeek?'🎓':('S'+sem.num)}</div>
      <div class="semaine-meta"><div class="semaine-title">${sem.title}</div><div class="semaine-dates">${sem.dates}</div></div>
      <div class="semaine-prog"></div>
    </div>`;
    const grid=document.createElement('div');
    grid.className='jours-grid';
    semDays.forEach(jour=>{
      const card=document.createElement('div');
      const fd=fmtDate(jour.date);
      const parts=fd.split(' ');
      const wday=parts[0],drest=parts.slice(1).join(' ');
      if(jour.off){
        card.className='jour-card off';
        card.innerHTML=`<div class="jour-head"><span class="jour-weekday">${wday}</span><span class="jour-datenum">${drest}</span></div><div class="jour-body"><p class="off-label">☀️ Jour OFF — repos</p></div>`;
      } else {
        const isExam=!!jour.exam;
        card.className='jour-card'+(isExam?' exam-day':'');
        const mainSeances=(jour.seances||[]).filter(s=>!s.bonus);
        const bonusSeances=(jour.seances||[]).filter(s=>s.bonus);
        const totalP=mainSeances.reduce((a,s)=>a+(s.p||0),0);
        const pLabel=totalP>0?`${totalP}p / jour`:'révision';
        const allDone=(jour.seances||[]).every((_,i)=>state[jour.date+'_'+i]);
        if(allDone&&(jour.seances||[]).length>0)card.classList.add('all-done');
        const rBadge=jour.resultats?`<span class="exam-badge-inline">⚠️ Résultats S8</span>`:'';
        const mainHtml=mainSeances.map((s)=>{
          const si=(jour.seances||[]).indexOf(s);
          return buildSeanceHtml(s,si,jour.date,isExam);
        }).join('');
        const bonusHtml=bonusSeances.length>0?bonusSeances.map((s)=>{
          const si=(jour.seances||[]).indexOf(s);
          return buildSeanceHtml(s,si,jour.date,false);
        }).join(''):'';
        card.innerHTML=`<div class="jour-head ${isExam?'exam-head':''}"><span class="jour-weekday">${wday}</span><span class="jour-datenum">${drest}${rBadge}</span><span class="jour-total-pages">${pLabel}</span></div><div class="jour-body">${mainHtml}${bonusHtml}</div>`;
      }
      grid.appendChild(card);
    });
    block.appendChild(grid);
    container.appendChild(block);
  });

  document.querySelectorAll('.check-box').forEach(el=>{
    el.addEventListener('click',e=>{
      const key=e.currentTarget.dataset.key;
      state[key]=!state[key];save();
      e.currentTarget.classList.toggle('done',state[key]);
      const card=e.currentTarget.closest('.jour-card');
      const mainChecks=[...card.querySelectorAll('.seance:not(.bonus-seance) .check-box')];
      const all=mainChecks.length>0&&mainChecks.every(c=>c.classList.contains('done'));
      card.classList.toggle('all-done',all);
      renderProgress();renderSemCounts();renderLegend();
    });
  });

  document.querySelectorAll('.bonus-btn').forEach(btn=>{
    btn.addEventListener('click',e=>{
      e.stopPropagation();
      const key=e.currentTarget.dataset.bonuskey;
      const val=e.currentTarget.dataset.val;
      const current=state['bonus_'+key]||'';
      // Toggle: re-cliquer sur actif = désactive
      state['bonus_'+key]=current===val?'':val;
      save();
      // Mettre à jour les deux boutons du groupe
      const container=e.currentTarget.closest('.bonus-seance');
      container.querySelectorAll('.bonus-btn').forEach(b=>{
        b.classList.toggle('active',state['bonus_'+key]===b.dataset.val);
      });
    });
  });
}

renderLegend();renderPlanning();renderProgress();renderSemCounts();
</script>
</body>
</html>
