function getRevisions(){
  const c={};ALL.forEach(m=>c[m.id]=0);
  DAYS.forEach(d=>{if(d.off)return;(d.seances||[]).forEach((s,si)=>{if(state[d.date+'_'+si]&&s.cm)c[s.mid]=(c[s.mid]||0)+1;});});
  return c;
}
function revClass(n){if(n>=5)return'revue-5';if(n===4)return'revue-4';if(n===3)return'revue-3';if(n===2)return'revue-2';if(n===1)return'revue-1';return'';}
function revLabel(n){return n>0?n+'x':'';}

function renderLegend(){
  const revs=getRevisions();
  [['legend-s7',S7],['legend-s8',S8]].forEach(([id,arr])=>{
    const el=document.getElementById(id);el.innerHTML='';
    arr.forEach(m=>{
      const n=revs[m.id]||0;
      el.innerHTML+=`<div class="matiere-badge ${revClass(n)}"><span class="badge-dot" style="background:${m.color}"></span><span class="badge-name">${m.label}</span><span class="badge-pages">${m.pages}p</span><span class="badge-count">${revLabel(n)}</span></div>`;
    });
  });
}

function renderProgress(){
  const total=DAYS.reduce((a,d)=>a+(d.seances?d.seances.filter(s=>!s.bonus).length:0),0);
  const done=DAYS.reduce((a,d)=>{if(!d.seances)return a;return a+d.seances.filter((s,si)=>!s.bonus&&state[d.date+'_'+si]).length;},0);
  const pct=total>0?Math.round(done/total*100):0;
  document.getElementById('pct-global').textContent=pct+'%';
  document.getElementById('bar-global').style.width=pct+'%';
  document.getElementById('done-count').textContent=done;
  document.getElementById('total-count').textContent=total;
}
function renderSemCounts(){
  document.querySelectorAll('.semaine-prog').forEach((el,i)=>{
    const s=SEMAINES[i];
    const days=DAYS.slice(s.slice[0],s.slice[1]+1);
    const total=days.reduce((a,d)=>a+(d.seances?d.seances.filter(s=>!s.bonus).length:0),0);
    const done=days.reduce((a,d)=>{if(!d.seances)return a;return a+d.seances.filter((s,si)=>!s.bonus&&state[d.date+'_'+si]).length;},0);
    el.innerHTML=`<strong>${done}</strong>/${total} séances`;
  });
}

function fmtDate(ds){
  const d=new Date(ds+'T12:00:00');
  return d.toLocaleDateString('fr-FR',{weekday:'long',day:'numeric',month:'long'});
}
function flagHtml(cm){
  if(!cm)return'';
  const map={lec1:['🏁','Fin lecture 1','lec1'],lec2:['🔄','Fin 2ème lecture','lec2'],lec3:['⭐','Fin 3ème lecture','lec3'],lec4:['🎯','Fin 4ème lecture','lec4']};
  const v=map[cm];if(!v)return'';
  return `<span class="finish-flag ${v[2]}">${v[0]} ${v[1]}</span>`;
}

function buildSeanceHtml(s,si,dateStr,isExam){
  const key=dateStr+'_'+si;
  const done=!!state[key];
  const m=getM(s.mid);
  const col=m?m.color:(isExam?'#856404':'#666');
  const isExamSeance=s.lab.includes('EXAMEN');
  const pTag=s.p>0?`${s.p} pages`:(isExamSeance?'':'relecture / révision');
  const tipHtml=s.tip?`<div class="seance-tip">${s.tip}</div>`:'';

  if(s.bonus){
    // Bonus: deux boutons indépendants, ne comptent pas dans la progression
    const bonusState=state['bonus_'+key]||''; // 'fait' ou 'nope'
    return `<div class="seance bonus-seance" data-bonuskey="${key}">
      <div class="seance-content">
        <div class="seance-moment" style="color:var(--bonus-pill)">📋 Bonus S7 — si tu as le temps</div>
        <div class="seance-mat-row"><span class="seance-mat" style="color:${col}">${s.lab}</span></div>
        <div class="seance-detail">${s.det}</div>
        <div class="bonus-buttons">
          <button class="bonus-btn btn-fait ${bonusState==='fait'?'active':''}" data-bonuskey="${key}" data-val="fait">✅ Fait</button>
          <button class="bonus-btn btn-nope ${bonusState==='nope'?'active':''}" data-bonuskey="${key}" data-val="nope">⏭ Pas eu le temps</button>
        </div>
      </div>
    </div>`;
  }

  const bonusCls='';
  return `<div class="seance${bonusCls}" data-key="${key}">
    <div class="check-box ${done?'done':''}" data-key="${key}"></div>
    <div class="seance-content">
      <div class="seance-moment">${s.mom}</div>
      <div class="seance-mat-row"><span class="seance-mat" style="color:${isExamSeance?'#856404':col}">${s.lab}</span>${flagHtml(s.cm)}</div>
      <div class="seance-detail">${s.det}</div>
      ${pTag?`<div class="seance-pages-tag">${pTag}</div>`:''}
      ${tipHtml}
    </div>
  </div>`;
}

