<link rel="apple-touch-icon" href="data:image/svg+xml;base64,">
<title>Planning Révisions — Rattrapages 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg:#f7f4ef; --surface:#ffffff; --surface2:#f2ede6;
  --border:#e0d9cf; --border2:#c8bfb3;
  --text:#2a2520; --text-muted:#7a7068; --text-dim:#b0a89e;
  --accent:#8b6f47; --accent-light:#f0e8dc;
  --rev1-bg:#edf7f0; --rev1-border:#a8d4b4; --rev1-pill:#3d8a52;
  --rev2-bg:#fefce8; --rev2-border:#d4c040; --rev2-pill:#8a7a10;
  --rev3-bg:#fef4ea; --rev3-border:#f0bc85; --rev3-pill:#c26820;
  --rev4-bg:#fff0e0; --rev4-border:#e89050; --rev4-pill:#b05010;
  --rev5-bg:#fff5f5; --rev5-border:#f0a0a0; --rev5-pill:#c04040;
  --exam-bg:#fff8e6; --exam-border:#f0c040;
  --bonus-bg:#f0f4ff; --bonus-border:#b0c0e8; --bonus-pill:#4060a8;
  --conso7:#c0522a; --dep:#3a72a8; --dip:#8040a0; --hdj:#1e8a60;
  --rm:#a07820; --succ:#c04040; --assur:#2878a8;
  --dca:#5a8a3a; --suret:#904898; --contimmo:#b03058;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;font-size:14px;line-height:1.5;}

header{background:var(--surface);border-bottom:2px solid var(--border);padding:2rem 2rem 1.5rem;max-width:1200px;margin:0 auto;}
h1{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:900;color:var(--text);line-height:1.1;}
h1 em{color:var(--accent);font-style:normal;}
.header-sub{font-size:0.7rem;color:var(--text-muted);letter-spacing:0.12em;text-transform:uppercase;margin-top:0.4rem;}
.progress-global{margin-top:1.4rem;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:1rem 1.3rem;}
.progress-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;gap:1rem;flex-wrap:wrap;}
.progress-label{font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-muted);font-weight:500;}
.progress-pct{font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--accent);font-weight:700;}
.bar-wrap{height:6px;background:var(--border);border-radius:4px;overflow:hidden;}
.bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),#c4a060);border-radius:4px;transition:width 0.4s ease;width:0%;}
.progress-stats{display:flex;gap:1.5rem;margin-top:0.5rem;flex-wrap:wrap;}
.progress-stat{font-size:0.68rem;color:var(--text-muted);}
.progress-stat strong{color:var(--text);}

main{max-width:1200px;margin:0 auto;padding:2rem;}
.note-box{background:var(--accent-light);border:1px solid var(--border2);border-left:4px solid var(--accent);border-radius:8px;padding:0.9rem 1.2rem;margin-bottom:1.5rem;font-size:0.75rem;color:var(--text-muted);line-height:1.7;}
.note-box strong{color:var(--accent);}

.symboles-legend{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:0.8rem;padding:0.7rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;font-size:0.7rem;color:var(--text-muted);}
.sym-item{display:flex;align-items:center;gap:0.4rem;}
.badge-colors{display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1.5rem;padding:0.7rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;font-size:0.68rem;color:var(--text-muted);align-items:center;}
.bc-item{display:flex;align-items:center;gap:0.3rem;}
.bc-pill{font-size:0.58rem;font-weight:700;padding:0.08rem 0.4rem;border-radius:10px;color:#fff;}

.legend-section{margin-bottom:1.5rem;}
.section-label{font-size:0.65rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-muted);font-weight:600;margin-bottom:0.7rem;padding-bottom:0.4rem;border-bottom:1px solid var(--border);}
.legend-grid{display:flex;flex-wrap:wrap;gap:0.45rem;}
.matiere-badge{display:flex;align-items:center;gap:0.45rem;padding:0.4rem 0.75rem;background:var(--surface);border:1.5px solid var(--border);border-radius:20px;font-size:0.72rem;transition:border-color 0.2s,background 0.2s;}
.matiere-badge.revue-1{border-color:var(--rev1-border);background:var(--rev1-bg);}
.matiere-badge.revue-2{border-color:var(--rev2-border);background:var(--rev2-bg);}
.matiere-badge.revue-3{border-color:var(--rev3-border);background:var(--rev3-bg);}
.matiere-badge.revue-4{border-color:var(--rev4-border);background:var(--rev4-bg);}
.matiere-badge.revue-5{border-color:var(--rev5-border);background:var(--rev5-bg);}
.badge-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.badge-name{color:var(--text);font-weight:500;}
.badge-pages{color:var(--text-dim);font-size:0.62rem;}
.badge-count{display:none;font-size:0.6rem;font-weight:700;padding:0.05rem 0.35rem;border-radius:10px;}
.revue-1 .badge-count{display:inline;background:var(--rev1-pill);color:#fff;}
.revue-2 .badge-count{display:inline;background:var(--rev2-pill);color:#fff;}
.revue-3 .badge-count{display:inline;background:var(--rev3-pill);color:#fff;}
.revue-4 .badge-count{display:inline;background:var(--rev4-pill);color:#fff;}
.revue-5 .badge-count{display:inline;background:var(--rev5-pill);color:#fff;}

.semaine-block{margin-bottom:2.5rem;}
.semaine-header{display:flex;align-items:center;gap:1rem;margin-bottom:1rem;padding:0.8rem 1rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;}
.semaine-header.exam-header{background:var(--exam-bg);border-color:var(--exam-border);}
.semaine-num{font-family:'Playfair Display',serif;font-size:2rem;font-weight:700;color:var(--accent);line-height:1;min-width:2.2rem;}
.semaine-meta{flex:1;}
.semaine-title{font-size:0.85rem;font-weight:600;color:var(--text);}
.semaine-dates{font-size:0.67rem;color:var(--text-muted);margin-top:0.1rem;}
.semaine-prog{font-size:0.7rem;color:var(--text-muted);white-space:nowrap;}
.semaine-prog strong{color:var(--accent);font-weight:700;}

.jours-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:0.75rem;}

.jour-card{background:var(--surface);border:1.5px solid var(--border);border-radius:8px;overflow:hidden;transition:border-color 0.2s,box-shadow 0.2s;}
.jour-card:hover{border-color:var(--border2);box-shadow:0 2px 8px rgba(0,0,0,0.06);}
.jour-card.off{opacity:0.45;background:var(--surface2);}
.jour-card.all-done{border-color:var(--rev1-border);background:var(--rev1-bg);}
.jour-card.exam-day{border-color:var(--exam-border);}

.jour-head{display:flex;justify-content:space-between;align-items:center;padding:0.6rem 0.9rem;background:var(--surface2);border-bottom:1px solid var(--border);gap:0.5rem;flex-wrap:wrap;}
.jour-head.exam-head{background:var(--exam-bg);}
.jour-weekday{font-size:0.6rem;letter-spacing:0.13em;text-transform:uppercase;color:var(--text-muted);font-weight:600;}
.jour-datenum{font-family:'Playfair Display',serif;font-size:0.95rem;color:var(--text);}
.jour-total-pages{font-size:0.62rem;color:var(--text-muted);background:var(--surface);padding:0.15rem 0.45rem;border-radius:10px;border:1px solid var(--border);white-space:nowrap;font-weight:500;}

.jour-body{padding:0.6rem 0.9rem;}
.seance{display:flex;align-items:flex-start;gap:0.6rem;padding:0.6rem 0;cursor:pointer;user-select:none;}
.seance+.seance{border-top:1px solid var(--border);}
.seance:hover .check-box:not(.done){border-color:var(--accent);}
.seance.bonus-seance{background:var(--bonus-bg);border-radius:6px;padding:0.5rem 0.6rem;margin-top:0.4rem;border:1px dashed var(--bonus-border);cursor:default;}
.seance.bonus-seance+.seance{border-top:none;}
.bonus-buttons{display:flex;gap:0.4rem;margin-top:0.35rem;}
.bonus-btn{font-size:0.62rem;font-weight:600;padding:0.2rem 0.55rem;border-radius:10px;border:1.5px solid var(--bonus-border);background:var(--surface);cursor:pointer;transition:all 0.18s;color:var(--bonus-pill);}
.bonus-btn:hover{background:var(--bonus-bg);}
.bonus-btn.btn-fait.active{background:#3d8a52;border-color:#3d8a52;color:#fff;}
.bonus-btn.btn-nope.active{background:#b0a89e;border-color:#b0a89e;color:#fff;}

.check-box{width:18px;height:18px;border:1.5px solid var(--border2);border-radius:4px;flex-shrink:0;margin-top:1px;display:flex;align-items:center;justify-content:center;transition:all 0.18s;background:var(--surface);}
.check-box.done{background:var(--rev1-pill);border-color:var(--rev1-pill);}
.check-box.done::after{content:'✓';font-size:11px;color:#fff;font-weight:700;}
.bonus-seance .check-box{border-color:var(--bonus-border);background:var(--bonus-bg);}
.bonus-seance .check-box.done{background:var(--bonus-pill);border-color:var(--bonus-pill);}

.seance-content{flex:1;min-width:0;}
.seance-moment{font-size:0.57rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-dim);font-weight:600;margin-bottom:0.15rem;}
.bonus-seance .seance-moment{color:var(--bonus-pill);}
.seance-mat-row{display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.12rem;}
.seance-mat{font-size:0.76rem;font-weight:600;}
.finish-flag{font-size:0.58rem;font-weight:600;padding:0.06rem 0.35rem;border-radius:10px;white-space:nowrap;flex-shrink:0;}
.finish-flag.lec1{background:var(--rev1-bg);color:var(--rev1-pill);border:1px solid var(--rev1-border);}
.finish-flag.lec2{background:var(--rev2-bg);color:var(--rev2-pill);border:1px solid var(--rev2-border);}
.finish-flag.lec3{background:var(--rev3-bg);color:var(--rev3-pill);border:1px solid var(--rev3-border);}
.finish-flag.lec4{background:var(--rev4-bg);color:var(--rev4-pill);border:1px solid var(--rev4-border);}
.seance-detail{font-size:0.66rem;color:var(--text-muted);line-height:1.45;}
.seance-pages-tag{font-size:0.6rem;color:var(--text-dim);margin-top:0.1rem;font-weight:500;}
.seance-tip{font-size:0.62rem;color:#856404;background:var(--exam-bg);border:1px solid var(--exam-border);border-radius:6px;padding:0.2rem 0.5rem;margin-top:0.3rem;line-height:1.4;}

.off-label{font-size:0.78rem;color:var(--text-dim);text-align:center;padding:0.8rem 0;font-style:italic;}
.exam-badge-inline{font-size:0.6rem;background:var(--exam-bg);border:1px solid var(--exam-border);color:#856404;border-radius:10px;padding:0.05rem 0.4rem;font-weight:700;margin-left:0.3rem;}

@media(max-width:600px){main{padding:1rem;}.jours-grid{grid-template-columns:1fr;}header{padding:1.5rem 1rem 1rem;}}
</style>
</head>
